# --- Google Gemini ---
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Neon PostgreSQL ---
# Copy the connection string from your Neon project dashboard.
# It must include ?sslmode=require (this app appends it automatically if missing).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT auth ---
# Secret used to sign access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
# Optional: token lifetime in minutes (default 7 days)
JWT_EXPIRE_MINUTES=10080
